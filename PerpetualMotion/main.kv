<MainScreen>:
    FloatLayout:
        size_hint: None, None

    DPEAButton:
        id: auto_manual_toggle
        text: "Toggle Manual"
        size_hint: (0.2, 0.1)
        pos_hint: {"x": 0.5, "y": 0.7}
        text_color: "black"
        fill_color: root.bluish_grey
        font_size: 21
        halign: 'center'
        on_press: root.toggle_auto_manual()


    DPEAButton:
        id: auto_start_stop
        text: "Start"
        size_hint: (0.1, 0.1 if root.auto_toggle else 0)
        pos_hint: {"x": 0.5, "y": 0.5}
        text_color: "black"
        fill_color: root.green

    Label:
        id: ramp_speed_label
        color: "black"
        pos_hint: {"x": 0.05, "y": 0.05}
        halign: "left"
        text: "Set Ramp Speed: 0"
        font_size: 21
        text_size: root.size
        size_hint: (0.2, 0.1)
        valign: "middle"


    Slider:
        id: ramp_speed_slider
        min: 0
        max: 100
        step: 1
        size_hint: (0.7, 0.1)
        pos_hint: {"right": 1, "y": 0.05}
        halign: "right"

    Label:
        id: stair_speed_label
        color: "black"
        pos_hint: {"x": 0.05, "y": 0.0}
        halign: "left"
        valign: "bottom"
        text: "Set Stair Speed: 0"
        font_size: 21
        text_size: root.size
        size_hint: (1, 0.1)

    Slider:
        id: stair_speed_slider
        min: 0
        max: 100
        step: 1
        size_hint: (0.7, 0.05)
        pos_hint: {"right": 1, "y": 0.025}
        halign: "right"

<Slider>
    value_track: True
    value_track_color: (0, 210/255.0, 0)